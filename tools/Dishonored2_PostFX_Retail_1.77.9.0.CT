    <CheatEntry>
      <ID>8</ID>
      <Description>"Instructions: attach Dishonored2.exe; edit numeric values. These extra retail CVars are experimental; effect ranges are not established. Lua syncs text/int/float and verifies the retail CVar name before writing."</Description>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
  <LuaScript><![CDATA[
local bindings = {
  {description = "Bloom bypass: 0 = normal, 1 = skip bloom", name = "r_skipBloom", type = "flag"},
  {description = "Bloom source mip (default 5; reconstruction range, not intensity)", name = "r_postProcessDebugBloomSourceMip", type = "mip"},
  {description = "Bloom target mip (default 3; reconstruction range, not intensity)", name = "r_postProcessDebugBloomTargetMip", type = "mip"},
  {description = "Emissive glare bypass: 0 = normal, 1 = skip", name = "r_skipEmissiveGlare", type = "flag"},
  {description = "Lens flare bypass: 0 = normal, 1 = skip lens flares", name = "r_skipLensFlares", type = "flag"},
  {description = "Cheap lens flare distortion: 0 = off, 1 = on (visual effect unverified)", name = "r_useCheapLensFlareDistortion", type = "flag"},
  {description = "Fog blur radius (default 6; visual effect unverified)", name = "r_fogBlurRadius", type = "float"},
  {description = "God-rays depth sharpness (default 0.00001; visual effect unverified)", name = "r_atmGodRaysDepthSharpness", type = "float"},
  {description = "Fog Gaussian blur: 0 = off, 1 = on (visual effect unverified)", name = "r_fogBlurGaussian", type = "flag"},
  {description = "Fog nearest upscale: 0 = off, 1 = on (visual effect unverified)", name = "r_fogNearestUpscale", type = "flag"},
  {description = "Fog nearest threshold (default 0.0002; visual effect unverified)", name = "r_fogNearestThreshold", type = "float"},
  {description = "Skip fog blur: 0 = normal, 1 = skip (visual effect unverified)", name = "r_skipFogBlur", type = "flag"},
  {description = "Gamma (retail value 2.2; visual effect unverified)", name = "r_gamma", type = "float"},
  {description = "OIT color resistance (default 3; transparency effect unverified)", name = "r_oitColorResistance", type = "float"},
  {description = "OIT additive color resistance (default 12; effect unverified)", name = "r_oitAdditiveColorResistance", type = "float"},
  {description = "OIT particle color strength (retail value 12; effect unverified)", name = "r_oitParticleColorStrength", type = "float"},
  {description = "OIT additive particle color strength (retail value 0; effect unverified)", name = "r_oitAdditiveParticleColorStrength", type = "float"},
  {description = "Force instant auto-exposure convergence: 0 = off, 1 = on (screenshot-oriented)", name = "r_forceInstantAutoExposureConvergence", type = "flag"},
  {description = "Skip fog underwater: 0 = normal, 1 = skip", name = "r_skipFogUnderWater", type = "flag"},
  {description = "Skip god rays underwater: 0 = normal, 1 = skip", name = "r_skipGodRaysUnderWater", type = "flag"},
  {description = "Exposure uses tone-mapping white level: 0 = off, 1 = on (effect unverified)", name = "r_postProcessExposureUseToneMappingWhiteLevel", type = "flag"},
  {description = "Global post-process bypass: 0 = normal, 1 = skip all post-process", name = "r_skipPostProcess", type = "flag"}
}

local function applyCvar(memrec, binding, newvalue)
  local value = tonumber(tostring(newvalue):gsub(",", "."))
  if not value or value ~= value or math.abs(value) > 100000 then
    print("[DH2 PostFX] Invalid value for " .. binding.name)
    return
  end

  if binding.type == "flag" then
    value = value == 0 and 0 or 1
  elseif binding.type == "mip" then
    value = math.floor(value + 0.5)
    if value < 0 or value > 12 then
      print("[DH2 PostFX] Mip value must be between 0 and 12")
      return
    end
  end

  local fieldOffset = binding.type == "float" and 0x2C or 0x28
  local cvarObject = memrec.CurrentAddress - fieldOffset
  local namePointer = readPointer(cvarObject + 0x30)
  local actualName = namePointer and readString(namePointer, 128, false) or nil
  if actualName ~= binding.name then
    print("[DH2 PostFX] Retail CVar check failed for " .. binding.name .. "; no linked fields changed")
    return
  end

  local text = binding.type == "float" and string.format("%.7g", value) or tostring(value)
  local buffer = {}
  for i = 1, 16 do buffer[i] = 0 end
  if #text > 15 then
    print("[DH2 PostFX] Text value is too long for " .. binding.name)
    return
  end
  for i = 1, #text do buffer[i] = string.byte(text, i) end

  local integerValue = binding.type == "float" and (value < 0 and math.ceil(value) or math.floor(value)) or value
  if not writeBytes(cvarObject + 0x10, buffer) or
     not writeInteger(cvarObject + 0x28, integerValue) or
     not writeFloat(cvarObject + 0x2C, value) then
    print("[DH2 PostFX] Write failed for " .. binding.name)
    return
  end

  print(string.format("[DH2 PostFX] %s = %s (text/int/float synchronized)", binding.name, text))
end

local addressList = getAddressList()
for _, binding in ipairs(bindings) do
  local currentBinding = binding
  local memrec = addressList.getMemoryRecordByDescription(currentBinding.description)
  if memrec then
    memrec.OnValueChangedByUser = function(record, oldvalue, newvalue)
      applyCvar(record, currentBinding, newvalue)
    end
  end
end
print("[DH2 PostFX] Table ready. Attach Dishonored2.exe, then edit a value; every write checks the supported retail CVar name. Experimental effect ranges are not established.")
  ]]></LuaScript>
</CheatTable>
